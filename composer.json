{
    "name": "tgigold/mash-disclaimer",
    "description": "Disclaimer Tool V4 (Tater): WLTP consumption values and Pkw-EnVKV disclaimers for BMW Group vehicles",
    "type": "project",
    "license": "Unlicense",
    "require": {
        "php": "^8.5",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Lab09\\Disclaimer\\": "src/"
        },
        "files": [
            "src/Support/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Lab09\\Disclaimer\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.5.12"
        },
        "platform-check": false,
        "allow-plugins": {}
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    }
}
